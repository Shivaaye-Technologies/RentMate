# Copy to .env for local development. Never commit the real .env.

# API
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173
# Proxy hops in front of the API (Render = 1). Defaults to 1 in production, 0 otherwise.
# TRUST_PROXY=1
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# SOULMATE LIVE (server only; never put these in VITE_* variables)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret   # as generated by LiveKit: 32+ characters, 12+ distinct
# Webhooks and room removal: a generated token (openssl rand -base64 48); guessable values are refused. Store the same value once in the database with
#   select private.set_integration_secret('livekit_webhook', '<value>');
# LIVE_WEBHOOK_DB_SECRET=generate-a-long-random-value-here
# Header your CDN sets with the visitor's country (e.g. cf-ipcountry). Unset = country unknown.
# LIVE_COUNTRY_HEADER=cf-ipcountry

# Google Play Billing (server only, sandbox first; docs/PLAY_BILLING_SANDBOX_RUNBOOK.md). All four or billing answers 503.
# GOOGLE_PLAY_PACKAGE_NAME=com.shivaayetechnologies.rentmate
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=paste-the-service-account-key-json-in-your-host-secret-store-not-here
# Generated (openssl rand -base64 48); store the same value once with
#   select private.set_integration_secret('play_billing', '<value>');
# BILLING_DB_SECRET=generate-a-long-random-value-here
# URL-safe token for the Pub/Sub push endpoint (openssl rand -hex 32)
# GOOGLE_PLAY_RTDN_TOKEN=generate-a-url-safe-random-value-here

# Web (Vite exposes only VITE_* variables to the browser)
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
