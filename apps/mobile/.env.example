# Public values only. They are compiled into the app and visible to anyone who unpacks it.
# Never put the Supabase service role key, LiveKit API key/secret or any other server secret here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
EXPO_PUBLIC_API_URL=https://your-api.onrender.com
